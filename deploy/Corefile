# Split DNS for instance names. Tailscale sends queries for these zones to the
# control VM's tailnet IP; everything else resolves publicly as usual.
#
# The api writes /zones/db.<zone> from the instances table and the file plugin
# reloads it.
vm.gavinf.com {
    file /zones/db.vm.gavinf.com vm.gavinf.com {
        reload 5s
        fallthrough
    }
    forward . 1.1.1.1 9.9.9.9
    cache 10
    log
    errors
}

# Static tailnet names for hosts that aren't instances (the Proxmox node).
dns.gavinf.com {
    hosts {
        100.106.79.65 pve.dns.gavinf.com
        fallthrough
    }
    forward . 1.1.1.1 9.9.9.9
    cache 10
    log
    errors
}

# Kubernetes ingress. Every *.k8s.gavinf.com name resolves to the k3s workers,
# where Traefik picks the app by Host header, so new Ingresses need no DNS change.
k8s.gavinf.com {
    template IN A {
        answer "{{ .Name }} 60 IN A 100.102.88.3"
        answer "{{ .Name }} 60 IN A 100.115.21.107"
    }
    template IN AAAA {
        rcode NOERROR
    }
    cache 10
    log
    errors
}
