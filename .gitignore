.DS_Store
.env
*.local

# SSH keys (mount at runtime; never commit private keys)
ssh/*-key
ssh/*-key.pub

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
.homecloud/

# Tooling caches
.wrangler/

# Web apps (Vite build artifacts; source is committed)
frontend/node_modules/
frontend/dist/
frontend/.wrangler/
frontend/dashboard/node_modules/
frontend/dashboard/dist/
frontend/gavinf-prod/node_modules/
frontend/gavinf-prod/dist/
frontend/gavinf-prod/.wrangler/
frontend/docs/node_modules/
frontend/docs/docs/.vitepress/dist/
frontend/docs/docs/.vitepress/cache/

# Agent tooling artifacts (not project code)
.agents/
.claude/
skills-lock.json
