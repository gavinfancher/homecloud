.DS_Store
.env
*.local

# SSH: keys and the real config are runtime-only; ssh/config.example is
# tracked. Never commit private keys or real hostnames.
ssh/*-key
ssh/*-key.pub
ssh/config

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
.homecloud/

# Tooling caches
.wrangler/

# Web apps (Vite build artifacts; source is committed)
frontend/node_modules/
frontend/dist/
frontend/.wrangler/

# Agent tooling artifacts (not project code)
.agents/
.claude/
skills-lock.json
