# Every setting homecloud reads. In prod these live in Infisical (project
# "homecloud", env "prod") and deploy.sh injects them; locally, keep them in
# Infisical env "dev" and run `infisical run --env=dev -- uv run homecloud`,
# or copy this file to .env.

# --- Proxmox (API token; the controller never SSHes to the node) -------------
PROXMOX_HOST=
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=homecloud
PROXMOX_TOKEN_VALUE=
PROXMOX_VERIFY_SSL=false
PROXMOX_NODE=pve-root
PROXMOX_STORAGE=local-lvm
PROXMOX_BRIDGE=vmbr0
# Directory storage with the "iso" and "import" content types.
PROXMOX_IMAGE_STORAGE=local

# --- Postgres -------------------------------------------------------------
# POSTGRES_* configure the postgres container; DATABASE_URL is what the api uses.
POSTGRES_USER=homecloud
POSTGRES_PASSWORD=
POSTGRES_DB=homecloud
DATABASE_URL=postgresql+psycopg://homecloud:<password>@postgres:5432/homecloud

# --- Tailscale (one API key: mints per-VM keys, lists/deletes devices) -------
# Expires after at most 90 days.
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=
VM_SSH_USER=ubuntu

# --- DNS (split DNS via CoreDNS on the control VM) ----------------------------
DOMAIN=vm.dns.gavinf.com
DNS_LEGACY_DOMAINS=vm.homecloud.gavinf.com
CONTROL_NODE_TAILSCALE_IP=
OWNER_USERNAME=

# --- Cloudflare Tunnel (remote-managed; routes live in the dashboard) --------
CLOUDFLARE_TUNNEL_TOKEN=

# --- Clerk (empty JWKS/issuer = auth disabled, dev only) ---------------------
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=https://homecloud.gavinf.com
CLERK_PUBLISHABLE_KEY=

# --- Console ------------------------------------------------------------------
FRONTEND_ORIGIN=https://homecloud.gavinf.com
CONSOLE_URL=https://homecloud.gavinf.com
