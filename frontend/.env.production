# Production build config for the SPA (non-secret).
VITE_API_BASE=https://homecloud-api.gavinf.com

# Clerk publishable keys are public by design — they ship inside the bundle.
# Pinning the live key here matters for a second reason: .env.local holds the
# pk_test key for the dev instance, and without this line a production build
# would pick it up and point homecloud.gavinf.com at dev Clerk.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZ2F2aW5mLmNvbSQ
